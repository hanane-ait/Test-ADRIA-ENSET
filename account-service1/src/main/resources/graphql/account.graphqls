type Account {
    id: ID!
    customerReference: String!
    status: AccountStatus!
    currency: String!
    balance: Float!
}

enum AccountStatus {
    ACTIVE
    BLOCKED
}

input CreateAccountInput {
    customerReference: String!
    currency: String!
    balance: Float!
}

type Query {
    account(id: ID!): Account
    accounts: [Account!]!
    balance(id: ID!): Float!
}

type Mutation {
    createAccount(input: CreateAccountInput!): Account!
}